{
  "name": "hermes-ctl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learn JavaScript/TypeScript by building Claude tools for a Bifrost homelab, step by step, while preparing for Claude Certified Developer – Foundations",
  "scripts": {
    "scratch": "tsx scratch.ts",
    "scratch:watch": "tsx watch scratch.ts",
    "hello:mcp": "tsx playground/mcp-hello/test-client.ts",

    "check": "tsx src/check.ts",
    "ask": "tsx src/ask.ts",
    "chat": "tsx src/chat.ts",
    "pii-test": "tsx src/pii/harness.ts",
    "agent": "tsx src/agent.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:http": "tsx src/mcp/http.ts",
    "inspector": "npx @modelcontextprotocol/inspector npx tsx src/mcp/server.ts",
    "bench": "tsx src/bench/bench.ts",

    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
