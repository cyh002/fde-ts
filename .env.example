# ── Step 00/01 ─────────────────────────────────────────────
# Bifrost's Anthropic-compatible endpoint. Must end in /anthropic.
BIFROST_BASE_URL=http://bifrost.lan:8080/anthropic
BIFROST_API_KEY=replace-with-your-bifrost-virtual-key
# Cheapest current model, ideal while learning. Check how your Bifrost config names models
# (some setups want a provider prefix, e.g. anthropic/claude-haiku-4-5).
CLAUDE_MODEL=claude-haiku-4-5

# ── Step 04 ────────────────────────────────────────────────
PROXMOX_URL=https://pve.lan:8006
# Read-only token (PVEAuditor role), format user@realm!tokenname
PROXMOX_TOKEN_ID=hermes@pve!readonly
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=pve
# name=healthURL pairs, comma-separated
HERMES_AGENTS=vm-a=http://10.0.0.11:8000/health,vm-b=http://10.0.0.12:8000/health
# Trust Proxmox's self-signed CA instead of disabling TLS checks
# NODE_EXTRA_CA_CERTS=./certs/pve-ca.pem

# ── Step 06 ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
HERMES_WRITE_ENABLED=false
DRY_RUN=true
